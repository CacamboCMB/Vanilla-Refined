{
  "schemaVersion": 1,
  "id": "ownmods_inventorysort",
  "version": "${version}",
  "name": "Vanilla Refined — Inventory Sort",
  "description": "Sortiert Inventar und Lager nach ID, Zusammengehörigkeit, Block-/Itemart oder Farbe.",
  "authors": [
    "CacamboCMB"
  ],
  "license": "MIT",
  "environment": "*",
  "depends": {
    "fabricloader": "${loader_runtime}",
    "minecraft": "${minecraft_runtime}",
    "java": "${java_runtime}",
    "fabric-api": "${fabric_api_runtime}",
    "ownmods_settings": ">=0.12.3-alpha.1"
  },
  "entrypoints": {
    "client": [
      "de.ownmods.inventorysort.client.InventorySortClient"
    ],
    "main": [
      "de.ownmods.inventorysort.InventorySortMod"
    ]
  },
  "mixins": [
    {
      "config": "ownmods_inventorysort.mixins.json",
      "environment": "client"
    }
  ],
  "custom": {
    "vanilla_refined:compatibility": "candidate-not-runtime-validated",
    "vanilla_refined:build_minecraft": "${minecraft_build}",
    "vanilla_refined:stage": "foundation-candidate"
  }
}
