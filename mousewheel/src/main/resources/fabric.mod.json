{
  "schemaVersion": 1,
  "id": "ownmods_mousewheel",
  "version": "${version}",
  "name": "Vanilla Refined — Mouse Wheel",
  "description": "Verschiebt Items mit dem Mausrad zwischen Inventar und Lager.",
  "authors": [
    "CacamboCMB"
  ],
  "license": "MIT",
  "environment": "client",
  "depends": {
    "fabricloader": "${loader_runtime}",
    "minecraft": "${minecraft_runtime}",
    "java": "${java_runtime}",
    "fabric-api": "${fabric_api_runtime}",
    "ownmods_settings": ">=0.12.3-alpha.1"
  },
  "entrypoints": {
    "client": [
      "de.ownmods.mousewheel.client.MouseWheelClient"
    ]
  },
  "mixins": [
    {
      "config": "ownmods_mousewheel.mixins.json",
      "environment": "client"
    }
  ],
  "custom": {
    "vanilla_refined:compatibility": "candidate-not-runtime-validated",
    "vanilla_refined:build_minecraft": "${minecraft_build}",
    "vanilla_refined:stage": "foundation-candidate"
  }
}
